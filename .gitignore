# ═══════════════════════════════════════════════════════════════════════════
# Nomi · .gitignore
# 纪律：只忽略产物/私有数据/本地派生，绝不误伤源文件。改动需过 check:filesize
# ═══════════════════════════════════════════════════════════════════════════

# ── 依赖 ────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.npm-cache/
.eslintcache
.prettiercache

# ── 构建产物 ─────────────────────────────────────────────────────────────
dist/
dist-electron/
dist-local/
release/
build-electron/
.tmp/
.turbo/
coverage/
*.tsbuildinfo
public/tailwind.generated.css
src/styles/tailwind.generated.css

# ── 测试产物 ─────────────────────────────────────────────────────────────
test-results/
playwright-report/
vitest-exit.txt
vitest-src.json

# ── 环境与密钥（本地私有，绝不入库）──────────────────────────────────
.env
.env.*
!.env.example
!.env.example.*
project-data/
.data/
**/.data/
artifacts/

# ── 用户/AI 会话本地数据 ───────────────────────────────────────────────
.agents/
.claude/
.tapcanvas/
.codex/
orchestration/

# ── Feedback Radar 用户私有数据 · 安全见 docs/security/ ────────────────
# whitelist 模式：docs/feedback/ 默认全 ignore，只放行模板与说明
docs/feedback/*
!docs/feedback/sources.example.json
!docs/feedback/README.md

# ── 微信取钥产物 / WeLive 配置 / 数据库 —— 任何位置都不许进 git ───────
**/welive.yaml
**/welive.yml
**/all_keys.json
**/keys.json
**/wechat_keys.json
**/wechat-export/
*.db

# ── 走查/试跑/校准台截图产物（本地证据，不入库）────────────────────────
tests/ux/shots/
tests/ux/__shots__/
tests/ux/_stagingshot/
tests/ux/_marketing/
tests/system/runs/
# 通用模式覆盖所有 .{name}-walk/ 与 .*-lab/ 输出；不合模式的特例单列
.*-walk/
.*-lab/
.failure-walk-ok/
.model-panel-shot/
.custom-call-recon/
.relay-fallback-walk/
.ue-spike-walk/
.pose-lab/
.pose-lab-vite.log
.independent-retest/

# ── 临时/一次性设计与着陆页 ─────────────────────────────────────────────
temp-web-design-skill/
nomi-landing/
landing-page-*.html

# ── 派生产物（按需生成，不提交）──────────────────────────────────────────
docs/stats/dashboard.html
docs/onboarding-trials/20*/

# ── Python 运行副产物 ──────────────────────────────────────────────────
__pycache__/
*.pyc

# ── 系统 / 编辑器 ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.out
*.err
.vscode/
.idea/
