registry=https://registry.npmjs.org
# 不设 store-dir：让 pnpm 用它自己的按平台默认位置（mac ~/Library/pnpm/store、Linux ~/.local/share/pnpm/store）。
# 曾经写死成相对路径 .pnpm-store，等于「store 建在当前项目目录里」——多 worktree 并行开发时每个 worktree
# 各建一个冷 store，装一次要重下全部依赖（实测 3.5min + 私有 store 1.3G），贵到只能靠软链共用一份
# node_modules，共享的那份一旦落后于 lockfile 就会缺新增直接依赖的顶层链接、Electron 启动即崩。
# 用默认位置后各 worktree 共享同一个内容寻址 store，装依赖不再走网络：packageImportMethod 默认 auto
# ＝先试 clone(CoW)、不支持才 hardlink、再不行才 copy（本机 APFS 走 clone，所以 node_modules 里的文件
# 链接数是 1 而不是共享 inode——删掉旧的项目内 .pnpm-store 不会影响已装好的 node_modules）。
# CI 不受影响：actions/setup-node 是跑 `pnpm store path --silent` 拿缓存目录的，跟着这里的配置走。

# pnpm 10 起，onlyBuiltDependencies / ignoredBuiltDependencies 不再读 package.json 的 "pnpm" 字段，
# 必须写在这里（见 https://pnpm.io/settings）。原样从 package.json 迁来，避免干净 install 时
# electron/esbuild/ffmpeg/ffprobe 的原生 postinstall 被默认全禁 → 装好却跑不起来。
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild
only-built-dependencies[]=@ffmpeg-installer/darwin-arm64
only-built-dependencies[]=@ffmpeg-installer/darwin-x64
only-built-dependencies[]=@ffmpeg-installer/linux-x64
only-built-dependencies[]=@ffmpeg-installer/win32-x64
only-built-dependencies[]=@ffprobe-installer/darwin-arm64
only-built-dependencies[]=@ffprobe-installer/darwin-x64
only-built-dependencies[]=@ffprobe-installer/linux-x64
only-built-dependencies[]=@ffprobe-installer/win32-x64
never-built-dependencies[]=@ffmpeg-installer/darwin-arm64
never-built-dependencies[]=@ffprobe-installer/darwin-arm64
